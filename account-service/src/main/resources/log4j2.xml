<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level: %msg%n"/>
        </Console>
        <Kafka name="Kafka" topic="bank-logs">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level: %msg%n"/>
            <Property name="bootstrap.servers">bank-kafka:9092</Property>
        </Kafka>
    </Appenders>
    <Loggers>
        <Logger name="ru.ugaforever.bank" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Kafka"/>
        </Logger>
        <Logger name="org.apache.kafka" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Kafka"/>
        </Logger>
        <Logger name="org.springframework" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Kafka"/>
        </Logger>
        <Logger name="org.apache.catalina" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Kafka"/>
        </Logger>
        <Logger name="org.hibernate" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Kafka"/>
        </Logger>
        <Logger name="com.zaxxer.hikari" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Kafka"/>
        </Logger>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Kafka"/>
        </Root>
    </Loggers>
</Configuration>